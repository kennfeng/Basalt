# Defaults below target local (non-Docker) runs: `python main.py`, `uvicorn app:app`.
# `docker compose up` also reads this file, but inside the app container use:
#   BASALT_DB_PATH=/data/basalt_db
#   BASALT_BASE_URL=http://ollama:11434
# Leave a variable unset to get the Compose built-in default.
BASALT_DB_PATH=./basalt_db
BASALT_PROVIDER=ollama
BASALT_LLM_MODEL=llama3.2:1b
BASALT_RERANKER_MODEL=BAAI/bge-reranker-base
BASALT_BASE_URL=http://localhost:11434
BASALT_N_RESULTS=10
BASALT_TOP_N=3
BASALT_BATCH_SIZE=1024
BASALT_EMBED_DEVICE=cpu
BASALT_EMBED_BATCH_SIZE=128
BASALT_EMBED_MODEL=all-MiniLM-L6-v2
# SECURITY: enables arbitrary code execution from HuggingFace repos; keep false unless model requires it
# BASALT_EMBED_TRUST_REMOTE_CODE=false
BASALT_VERBOSE=false
BASALT_HNSW_M=16
BASALT_HNSW_CONSTRUCTION_EF=200
BASALT_HNSW_SEARCH_EF=10
BASALT_AUTO_SEED=true
BASALT_HYBRID=true
BASALT_HYBRID_DENSE_N=50
BASALT_HYBRID_SPARSE_N=50
BASALT_HYBRID_RRF_K=60
BASALT_HYBRID_TOP_N=20
BASALT_RERANKER_DEVICE=cpu
BASALT_RERANKER_BATCH_SIZE=32
# BASALT_RERANKER_FP16=false
BASALT_MAX_CONCURRENCY=4
BASALT_ASK_TIMEOUT=30
BASALT_ALLOW_SEED_WIPE=false
BASALT_BM25_SHARDED=false
BASALT_BM25_TANTIVY=false
# BASALT_API_KEY=
# BASALT_CHROMA_HOST=
# BASALT_CHROMA_PORT=8000
# HF_HOME=./hf-cache
# SENTENCE_TRANSFORMERS_HOME=./hf-cache
