# Defaults below target local (non-Docker) runs: `python main.py`, `uvicorn app:app`.
# `docker compose up` also reads this file, but inside the app container use:
#   ATLAS_DB_PATH=/data/atlas_db
#   ATLAS_OLLAMA_BASE_URL=http://ollama:11434
# Leave a variable unset to get the Compose built-in default.
ATLAS_DB_PATH=./atlas_db
ATLAS_PROVIDER=ollama
ATLAS_LLM_MODEL=llama3.2:1b
ATLAS_RERANKER_MODEL=BAAI/bge-reranker-base
ATLAS_OLLAMA_BASE_URL=http://localhost:11434
ATLAS_N_RESULTS=10
ATLAS_TOP_N=3
# HF_HOME=./hf-cache
